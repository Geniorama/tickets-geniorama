generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  ADMINISTRADOR
  COLABORADOR
  CLIENTE
}

enum CompanyType {
  AGENCIA
  EMPRESA
}

enum PlanType {
  BOLSA_HORAS
  SOPORTE_MENSUAL
}

enum TicketStatus {
  POR_ASIGNAR
  ABIERTO
  EN_PROGRESO
  EN_REVISION
  CERRADO
}

enum Priority {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

enum ProjectStatus {
  PLANIFICACION
  EN_DESARROLLO
  EN_REVISION
  COMPLETADO
  PAUSADO
}

enum TaskStatus {
  PENDIENTE
  EN_PROGRESO
  EN_REVISION
  COMPLETADO
}

enum RecurrenceFrequency {
  DIARIA
  SEMANAL
  MENSUAL
}

enum ServiceType {
  DOMINIO
  HOSTING
  CORREO
  SSL
  MANTENIMIENTO
  OTRO
}

enum ServiceProvider {
  GENIORAMA
  EXTERNO
}

enum ReactionType {
  LIKE
  GENIO
  DISLIKE
  REVISANDO
}

// ─── Permisos por app (Fase 1) ───────────────────────────────────────────────

// Los módulos a los que se concede acceso. `ADMIN` agrupa la administración
// (usuarios, empresas, planes, estadísticas). Los que aún no existen se
// declaran igual para poder preparar perfiles; el registro de
// src/lib/access/apps.ts marca cuáles están construidos.
enum AppKey {
  TICKETS
  PROYECTOS
  INFRAESTRUCTURA
  PORTAL
  ADMIN
  CRM
}

// Nivel dentro de un módulo. Es independiente del rol: el rol delimita QUÉ
// registros ve alguien (su frontera de datos) y el nivel, QUÉ puede hacer con
// los que ya ve. Un nivel nunca amplía la frontera del rol.
enum AccessLevel {
  SIN_ACCESO
  LECTURA
  MIEMBRO
  GESTOR
}

enum SchedulingLinkCategory {
  PROYECTOS
  SOPORTE
}

// Núcleo compartido: identifica a qué entidad pertenece un registro polimórfico
// (comentarios, y más adelante adjuntos, checklists, tiempo y actividad).
// Al agregar una app nueva se añade su valor aquí.
enum EntityType {
  TICKET
  TASK
  PROJECT
}

// ─── Models ──────────────────────────────────────────────────────────────────

model Company {
  id               String      @id @default(cuid())
  name             String
  type             CompanyType @default(EMPRESA) @map("type")
  taxId            String?     @map("tax_id")
  logoUrl          String?     @map("logo_url")
  logoStoragePath  String?     @map("logo_storage_path")
  isActive         Boolean     @default(true) @map("is_active")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  parentId         String?     @map("parent_id")
  parent           Company?    @relation("AgencySubCompanies", fields: [parentId], references: [id])
  subCompanies     Company[]   @relation("AgencySubCompanies")

  users            User[]
  plans            Plan[]
  projects         Project[]
  services         Service[]
  sites            Site[]
  vaultEntries     VaultEntry[]

  @@map("companies")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(CLIENTE)
  cargo        String?
  area         String?
  bio              String?  @db.Text
  avatarUrl         String? @map("avatar_url")
  avatarStoragePath String? @map("avatar_storage_path")
  isProjectManager Boolean  @default(false) @map("is_project_manager")
  isSupportAgent   Boolean  @default(false) @map("is_support_agent")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  companies    Company[]
  schedulingLinks SchedulingLink[]

  createdTickets   Ticket[]             @relation("CreatedBy")
  assignedTickets  Ticket[]             @relation("AssignedTo")
  reviewingTickets Ticket[]             @relation("TicketReviewers")
  clientTickets    Ticket[]             @relation("TicketClient")
  comments         TicketComment[]
  attachments      TicketAttachment[]
  resetTokens      PasswordResetToken[]
  legacyTimeEntries TicketTimeEntryLegacy[]

  managedProjects  Project[]            @relation("ProjectManager")
  createdProjects  Project[]            @relation("ProjectCreatedBy")
  assignedTasks    Task[]               @relation("TaskAssignedTo")
  reviewingTasks   Task[]               @relation("TaskReviewers")
  createdTasks     Task[]               @relation("TaskCreatedBy")
  taskComments     TaskComment[]
  taskAttachments  TaskAttachment[]
  createdServices  Service[]            @relation("ServiceCreatedBy")
  taskTimeEntries  TaskTimeEntry[]

  createdVaultEntries VaultEntry[]      @relation("VaultCreatedBy")
  vaultShares         VaultShare[]      @relation("VaultSharedWith")
  projectAttachments  ProjectAttachment[]
  projectMemberships        ProjectMember[]
  projectFavorites          ProjectFavorite[]
  ticketCommentReactions    TicketCommentReaction[]
  taskCommentReactions      TaskCommentReaction[]

  // Núcleo compartido
  authoredComments          Comment[]               @relation("CommentAuthor")
  commentReactions          CommentReaction[]       @relation("CommentReactionUser")
  uploadedAttachments       Attachment[]            @relation("AttachmentUploadedBy")
  createdChecklists         Checklist[]             @relation("ChecklistCreatedBy")
  createdChecklistItems     ChecklistItem[]         @relation("ChecklistItemCreatedBy")
  timeEntries               TimeEntry[]             @relation("TimeEntryUser")
  createdTemplates          Template[]              @relation("TemplateCreatedBy")

  // Permisos por app
  profileId                 String?                 @map("profile_id")
  profile                   AccessProfile?          @relation(fields: [profileId], references: [id])
  appAccess                 AppAccess[]
  notifications             Notification[]
  webhooks                  UserWebhook[]
  ticketChecklists          TicketChecklist[]
  taskChecklists            TaskChecklist[]
  ticketChecklistItems      TicketChecklistItem[]
  taskChecklistItems        TaskChecklistItem[]

  createdRecurringTemplates  RecurringTaskTemplate[] @relation("RecurringCreatedBy")
  assignedRecurringTemplates RecurringTaskTemplate[] @relation("RecurringAssignedTo")
  createdTaskTemplates       TaskTemplate[]          @relation("TaskTemplateCreatedBy")
  createdTicketTemplates     TicketTemplate[]        @relation("TicketTemplateCreatedBy")
  briefRoutings              BriefRouting[]          @relation("BriefRoutingAssignedTo")

  @@map("users")
}

model Ticket {
  id           String       @id @default(cuid())
  title        String
  description  String
  status       TicketStatus @default(ABIERTO)
  priority     Priority     @default(MEDIA)
  category     String?
  isDraft      Boolean      @default(false) @map("is_draft")

  createdById  String   @map("created_by_id")
  assignedToId String?  @map("assigned_to_id")
  clientId     String?  @map("client_id")
  planId       String?  @map("plan_id")
  siteId       String?  @map("site_id")

  prefix       String?
  number       Int      @default(0)

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  dueDate      DateTime? @map("due_date")

  createdBy    User               @relation("CreatedBy", fields: [createdById], references: [id])
  assignedTo   User?              @relation("AssignedTo", fields: [assignedToId], references: [id])
  reviewers    User[]             @relation("TicketReviewers")
  client       User?              @relation("TicketClient", fields: [clientId], references: [id])
  plan         Plan?              @relation(fields: [planId], references: [id])
  site         Site?              @relation(fields: [siteId], references: [id])
  comments        TicketComment[]
  attachments     TicketAttachment[]
  legacyTimeEntries TicketTimeEntryLegacy[]
  vaultEntries    TicketVaultEntry[]
  checklists      TicketChecklist[]

  @@map("tickets")
}

model Plan {
  id           String    @id @default(cuid())
  name         String
  type         PlanType
  totalHours   Float?    @map("total_hours")
  durationDays Int?      @map("duration_days")
  startedAt    DateTime  @default(now()) @map("started_at")
  expiresAt    DateTime? @map("expires_at")
  isActive     Boolean   @default(true) @map("is_active")

  companyId    String    @map("company_id")
  company      Company   @relation(fields: [companyId], references: [id])

  tickets      Ticket[]

  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("plans")
}

model TicketComment {
  id         String   @id @default(cuid())
  body       String
  isInternal Boolean  @default(false) @map("is_internal")

  // Adjunto opcional (link externo o archivo)
  attachmentType        String? @map("attachment_type")         // "link" | "file"
  attachmentUrl         String? @map("attachment_url")
  attachmentName        String? @map("attachment_name")
  attachmentStoragePath String? @map("attachment_storage_path") // solo archivos Supabase

  ticketId   String   @map("ticket_id")
  authorId   String   @map("author_id")

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author     User     @relation(fields: [authorId], references: [id])
  reactions  TicketCommentReaction[]
  attachments TicketCommentAttachment[]

  @@map("ticket_comments")
}

model TicketCommentAttachment {
  id          String   @id @default(cuid())
  type        String   // "link" | "file"
  url         String
  name        String?
  storagePath String?  @map("storage_path") // null para enlaces

  commentId   String   @map("comment_id")
  createdAt   DateTime @default(now()) @map("created_at")

  comment     TicketComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([commentId])
  @@map("ticket_comment_attachments")
}

model TicketCommentReaction {
  commentId String       @map("comment_id")
  userId    String       @map("user_id")
  type      ReactionType

  comment   TicketComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@id([commentId, userId])
  @@map("ticket_comment_reactions")
}

model TicketAttachment {
  id           String   @id @default(cuid())
  fileUrl      String   @map("file_url")
  fileName     String   @map("file_name")
  storagePath  String   @map("storage_path")

  ticketId     String   @map("ticket_id")
  uploadedById String   @map("uploaded_by_id")

  createdAt    DateTime @default(now()) @map("created_at")

  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])

  @@map("ticket_attachments")
}

// Legacy: reemplazado por el modelo compartido `TimeEntry`. Se conserva sin uso
// hasta verificar en producción. Su tabla pasó de `time_entries` a
// `ticket_time_entries` para liberar el nombre al modelo compartido, quedando
// además simétrica con su hermana `task_time_entries`.
model TicketTimeEntryLegacy {
  id         String    @id @default(cuid())
  startedAt  DateTime  @map("started_at")
  stoppedAt  DateTime? @map("stopped_at")

  ticketId   String    @map("ticket_id")
  userId     String    @map("user_id")

  ticket     Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id])

  @@map("ticket_time_entries")
}

model TaskTimeEntry {
  id        String    @id @default(cuid())
  startedAt DateTime  @map("started_at")
  stoppedAt DateTime? @map("stopped_at")

  taskId    String    @map("task_id")
  userId    String    @map("user_id")

  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@map("task_time_entries")
}

// Links de agendamiento de llamadas de un colaborador (Google Calendar, Calendly, etc.).
// Cada link tiene título, descripción opcional y una categoría que determina si aplica a
// proyectos (tareas) o a soporte (tickets). El agendamiento ocurre en el link externo.
model SchedulingLink {
  id          String                 @id @default(cuid())
  title       String
  description String?
  url         String
  category    SchedulingLinkCategory
  position    Int                    @default(0)

  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("scheduling_links")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String        @db.Text
  status      ProjectStatus @default(PLANIFICACION)
  isActive    Boolean       @default(true) @map("is_active")
  isPrivate   Boolean       @default(false) @map("is_private")
  startDate   DateTime?     @map("start_date")
  dueDate     DateTime?     @map("due_date")

  companyId   String?       @map("company_id")
  managerId   String?       @map("manager_id")
  createdById String        @map("created_by_id")

  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  company      Company?            @relation(fields: [companyId], references: [id])
  manager      User?               @relation("ProjectManager", fields: [managerId], references: [id])
  createdBy    User                @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  tasks        Task[]
  vaultEntries ProjectVaultEntry[]
  attachments  ProjectAttachment[]
  members      ProjectMember[]
  favorites    ProjectFavorite[]
  recurringTemplates RecurringTaskTemplate[]

  @@map("projects")
}

model ProjectFavorite {
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@map("project_favorites")
}

model ProjectMember {
  projectId String @map("project_id")
  userId    String @map("user_id")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  addedAt DateTime @default(now()) @map("added_at")

  @@id([projectId, userId])
  @@map("project_members")
}

model ProjectAttachment {
  id           String   @id @default(cuid())
  type         String   @default("file")     // "file" | "link"
  fileUrl      String   @map("file_url")     // URL para files o la URL del enlace
  fileName     String   @map("file_name")    // Nombre a mostrar
  storagePath  String?  @map("storage_path") // Solo para archivos en R2

  position     Int      @default(0)

  projectId    String   @map("project_id")
  uploadedById String   @map("uploaded_by_id")

  createdAt    DateTime @default(now()) @map("created_at")

  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])

  @@map("project_attachments")
}

model ProjectVaultEntry {
  projectId    String     @map("project_id")
  vaultEntryId String     @map("vault_entry_id")

  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vaultEntry   VaultEntry @relation(fields: [vaultEntryId], references: [id], onDelete: Cascade)

  addedAt      DateTime   @default(now()) @map("added_at")

  @@id([projectId, vaultEntryId])
  @@map("project_vault_entries")
}

model Task {
  id             String     @id @default(cuid())
  title          String
  description    String
  status         TaskStatus @default(PENDIENTE)
  priority       Priority   @default(MEDIA)
  category       String?
  isDraft        Boolean    @default(false) @map("is_draft")

  number         Int        @default(0)

  /// Identificador del sistema externo que originó la tarea (p. ej. el id de
  /// ejecución de n8n). Es único para que un reintento del webhook no cree un
  /// duplicado: la integración busca por aquí antes de insertar.
  externalRef    String?    @unique @map("external_ref")

  startDate      DateTime?  @map("start_date")
  startTime      String?    @map("start_time")
  dueDate        DateTime?  @map("due_date")
  endTime        String?    @map("end_time")
  estimatedHours Float?     @map("estimated_hours")

  projectId           String?  @map("project_id")
  assignedToId        String?  @map("assigned_to_id")
  createdById         String   @map("created_by_id")
  recurringTemplateId String?  @map("recurring_template_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project    Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedTo User?         @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  reviewers  User[]        @relation("TaskReviewers")
  createdBy  User          @relation("TaskCreatedBy", fields: [createdById], references: [id])
  recurringTemplate RecurringTaskTemplate? @relation(fields: [recurringTemplateId], references: [id], onDelete: SetNull)
  comments       TaskComment[]
  attachments    TaskAttachment[]
  timeEntries    TaskTimeEntry[]
  checklists     TaskChecklist[]

  @@map("tasks")
}

model RecurringTaskTemplate {
  id                String   @id @default(cuid())
  title             String
  description       String   @db.Text
  priority          Priority @default(MEDIA)
  category          String?
  estimatedHours    Float?   @map("estimated_hours")
  /// Checklists en borrador: `[{ title, items: string[] }]` (ver src/lib/checklist.ts)
  checklist         Json     @default("[]")

  projectId         String?  @map("project_id")
  assignedToId      String?  @map("assigned_to_id")
  createdById       String   @map("created_by_id")

  frequency         RecurrenceFrequency
  interval          Int      @default(1)
  daysOfWeek        String?  @map("days_of_week")
  dayOfMonth        Int?     @map("day_of_month")

  startDate         DateTime @map("start_date")
  endDate           DateTime? @map("end_date")
  nextRunAt         DateTime @map("next_run_at")
  lastRunAt         DateTime? @map("last_run_at")
  isActive          Boolean  @default(true) @map("is_active")

  dueDateOffsetDays Int      @default(0) @map("due_date_offset_days")

  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  project        Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignedTo     User?     @relation("RecurringAssignedTo", fields: [assignedToId], references: [id])
  createdBy      User      @relation("RecurringCreatedBy", fields: [createdById], references: [id])
  generatedTasks Task[]

  @@index([isActive, nextRunAt])
  @@map("recurring_task_templates")
}

// Plantillas reutilizables de tarea: el staff las crea para prellenar el
// formulario de "Nueva tarea" o generar una tarea directamente. Son globales
// (compartidas por todo el staff). No tienen calendario (eso es RecurringTaskTemplate).
model TaskTemplate {
  id             String   @id @default(cuid())
  name           String
  title          String
  description    String   @db.Text
  priority       Priority @default(MEDIA)
  category       String?
  estimatedHours Float?   @map("estimated_hours")
  /// Checklists en borrador: `[{ title, items: string[] }]` (ver src/lib/checklist.ts)
  checklist      Json     @default("[]")

  createdById    String   @map("created_by_id")
  createdBy      User     @relation("TaskTemplateCreatedBy", fields: [createdById], references: [id])

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("task_templates")
}

// Enrutamiento de briefs entrantes (n8n → /api/integrations/brief).
//
// El cliente diligencia un brief en n8n y este llega al webhook con un
// `briefType`. Esta tabla dice a quién se le asigna la tarea resultante y con
// qué valores por defecto. El proyecto NO vive aquí: n8n siempre manda el
// `projectId` en el payload, así que un mismo tipo de brief puede caer en
// proyectos distintos sin tocar la configuración.
model BriefRouting {
  id             String   @id @default(cuid())
  /// Valor que manda n8n en `briefType`. Se normaliza a minúsculas al guardar
  /// y al buscar, para que "Web" y "web" sean lo mismo.
  briefType      String   @unique @map("brief_type")
  /// Nombre legible para la pantalla de administración ("Brief de sitio web").
  label          String
  assignedToId   String   @map("assigned_to_id")
  priority       Priority @default(MEDIA)
  category       String?
  estimatedHours Float?   @map("estimated_hours")

  /// Plazo de entrega en **días hábiles** desde que entra el brief. Null = sin
  /// plazo automático (la tarea nace sin fecha límite, salvo que n8n mande una).
  dueDays        Int?     @map("due_days")
  /// Hora límite del día de entrega, "HH:MM". Se guarda en `Task.endTime`, que
  /// es como el resto de la app almacena la hora: aparte de la fecha, para no
  /// arrastrar la zona horaria dentro del DateTime.
  dueTime        String?  @map("due_time")

  isActive       Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  assignedTo User @relation("BriefRoutingAssignedTo", fields: [assignedToId], references: [id])

  @@map("brief_routings")
}

// Plantillas reutilizables de ticket. Sirven para prellenar el formulario de
// "Nuevo ticket". Son globales (compartidas por todo el staff) y no incluyen
// cliente/plan/sitio (esos dependen del ticket concreto que se crea).
model TicketTemplate {
  id             String   @id @default(cuid())
  name           String
  title          String
  description    String   @db.Text
  priority       Priority @default(MEDIA)
  category       String?
  /// Checklists en borrador: `[{ title, items: string[] }]` (ver src/lib/checklist.ts)
  checklist      Json     @default("[]")

  createdById    String   @map("created_by_id")
  createdBy      User     @relation("TicketTemplateCreatedBy", fields: [createdById], references: [id])

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("ticket_templates")
}

model TaskComment {
  id                    String   @id @default(cuid())
  body                  String
  attachmentType        String?  @map("attachment_type")
  attachmentUrl         String?  @map("attachment_url")
  attachmentName        String?  @map("attachment_name")
  attachmentStoragePath String?  @map("attachment_storage_path")

  taskId   String @map("task_id")
  authorId String @map("author_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  task      Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User @relation(fields: [authorId], references: [id])
  reactions TaskCommentReaction[]
  attachments TaskCommentAttachment[]

  @@map("task_comments")
}

model TaskCommentAttachment {
  id          String   @id @default(cuid())
  type        String   // "link" | "file"
  url         String
  name        String?
  storagePath String?  @map("storage_path") // null para enlaces

  commentId   String   @map("comment_id")
  createdAt   DateTime @default(now()) @map("created_at")

  comment     TaskComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([commentId])
  @@map("task_comment_attachments")
}

model TaskCommentReaction {
  commentId String       @map("comment_id")
  userId    String       @map("user_id")
  type      ReactionType

  comment   TaskComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@id([commentId, userId])
  @@map("task_comment_reactions")
}

model TaskAttachment {
  id           String   @id @default(cuid())
  fileUrl      String   @map("file_url")
  fileName     String   @map("file_name")
  storagePath  String   @map("storage_path")

  taskId       String @map("task_id")
  uploadedById String @map("uploaded_by_id")

  createdAt DateTime @default(now()) @map("created_at")

  task       Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy User @relation(fields: [uploadedById], references: [id])

  @@map("task_attachments")
}

model Service {
  id          String          @id @default(cuid())
  name        String
  type        ServiceType
  provider    ServiceProvider @default(GENIORAMA)
  description String?
  dueDate     DateTime?       @map("due_date")
  price       Float?
  notes       String?
  isActive    Boolean         @default(true) @map("is_active")

  companyId   String          @map("company_id")
  createdById String          @map("created_by_id")

  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  company      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy    User            @relation("ServiceCreatedBy", fields: [createdById], references: [id])
  vaultEntries VaultEntry[]

  @@map("services")
}

// ─── Núcleo compartido ───────────────────────────────────────────────────────
//
// Comentarios polimórficos: una sola tabla para tickets, tareas y lo que venga
// (negocios del CRM, facturas, documentos). Reemplazan a TicketComment y
// TaskComment, que se conservan sin uso hasta verificar la migración en
// producción y se eliminan en una migración posterior.
//
// Prisma no puede garantizar integridad referencial sobre `entityId`: no hay
// clave foránea ni borrado en cascada desde el ticket o la tarea. Ese contrato
// vive en src/lib/comments.ts — usa `deleteCommentsFor()` en todo camino que
// borre una entidad comentable.

model Comment {
  id         String     @id @default(cuid())
  entityType EntityType @map("entity_type")
  entityId   String     @map("entity_id")

  body       String
  isInternal Boolean    @default(false) @map("is_internal")

  // Adjunto inline heredado del esquema viejo. Se conserva para no perder
  // comentarios históricos; los adjuntos nuevos van en CommentAttachment.
  attachmentType        String? @map("attachment_type")
  attachmentUrl         String? @map("attachment_url")
  attachmentName        String? @map("attachment_name")
  attachmentStoragePath String? @map("attachment_storage_path")

  authorId   String   @map("author_id")

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  author      User                @relation("CommentAuthor", fields: [authorId], references: [id])
  attachments CommentAttachment[]
  reactions   CommentReaction[]

  @@index([entityType, entityId, createdAt])
  @@index([authorId])
  @@map("comments")
}

model CommentAttachment {
  id          String   @id @default(cuid())
  type        String   // "link" | "file"
  url         String
  name        String?
  storagePath String?  @map("storage_path") // null para enlaces

  commentId   String   @map("comment_id")
  createdAt   DateTime @default(now()) @map("created_at")

  comment     Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([commentId])
  @@map("comment_attachments")
}

// Adjuntos polimórficos: reemplazan a TicketAttachment, TaskAttachment y
// ProjectAttachment, que se conservan sin uso hasta verificar en producción.
//
// Unifica además tres convenciones distintas para distinguir un enlace de un
// archivo: los tickets no tenían enlaces, los proyectos usaban la columna
// `type`, y las tareas marcaban el enlace con el centinela
// `storagePath = "link"`. Aquí manda `type`, y `storagePath` es null en enlaces.
//
// Igual que con los comentarios, no hay clave foránea sobre `entityId`: usa
// `deleteAttachmentsFor()` en todo camino que borre una entidad con adjuntos.
model Attachment {
  id           String     @id @default(cuid())
  entityType   EntityType @map("entity_type")
  entityId     String     @map("entity_id")

  type         String     @default("file")   // "file" | "link"
  fileUrl      String     @map("file_url")
  fileName     String     @map("file_name")
  storagePath  String?    @map("storage_path") // null en enlaces
  position     Int        @default(0)

  uploadedById String     @map("uploaded_by_id")
  createdAt    DateTime   @default(now()) @map("created_at")

  uploadedBy   User       @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id])

  @@index([entityType, entityId, position, createdAt])
  @@index([uploadedById])
  @@map("attachments")
}

// Checklists polimórficos: reemplazan a TicketChecklist y TaskChecklist (y sus
// ítems), que se conservan sin uso hasta verificar en producción.
//
// Solo la relación con la entidad es polimórfica. Los ítems mantienen clave
// foránea real hacia el checklist, así que siguen cayendo en cascada; lo que
// hay que borrar a mano es el checklist cuando se elimina su ticket o tarea
// (`deleteChecklistsFor()`).
model Checklist {
  id          String     @id @default(cuid())
  entityType  EntityType @map("entity_type")
  entityId    String     @map("entity_id")

  title       String
  position    Int        @default(0)

  createdById String     @map("created_by_id")

  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  createdBy   User            @relation("ChecklistCreatedBy", fields: [createdById], references: [id])
  items       ChecklistItem[]

  @@index([entityType, entityId, position])
  @@map("checklists")
}

model ChecklistItem {
  id          String   @id @default(cuid())
  title       String
  isChecked   Boolean  @default(false) @map("is_checked")
  position    Int      @default(0)

  checklistId String   @map("checklist_id")
  createdById String   @map("created_by_id")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  createdBy   User      @relation("ChecklistItemCreatedBy", fields: [createdById], references: [id])

  @@index([checklistId, position])
  @@map("checklist_items")
}

// Registros de tiempo polimórficos: reemplazan al par TimeEntry (tickets) y
// TaskTimeEntry (tareas), conservados sin uso hasta verificar en producción.
//
// Es el modelo que alimentará la facturación: el consumo de horas de un plan
// se calcula sumando las entradas cerradas de los tickets de ese plan
// (`getPlanUsedHours`). Una entrada con `stoppedAt` nulo es un contador en
// marcha y no cuenta como tiempo consumido.
model TimeEntry {
  id         String     @id @default(cuid())
  entityType EntityType @map("entity_type")
  entityId   String     @map("entity_id")

  startedAt  DateTime   @map("started_at")
  stoppedAt  DateTime?  @map("stopped_at")

  userId     String     @map("user_id")
  user       User       @relation("TimeEntryUser", fields: [userId], references: [id])

  @@index([entityType, entityId, startedAt])
  // El contador flotante busca la entrada abierta del usuario en cada carga.
  @@index([userId, stoppedAt])
  @@map("time_entries")
}

// Plantillas polimórficas: reemplazan a TicketTemplate y TaskTemplate.
// A diferencia del resto del núcleo, `entityType` no apunta a una entidad
// concreta sino que indica **qué crea** la plantilla. Por eso no hay entityId.
model Template {
  id             String     @id @default(cuid())
  entityType     EntityType @map("entity_type")

  name           String
  title          String
  description    String     @db.Text
  priority       Priority   @default(MEDIA)
  category       String?
  /// Solo lo usan las plantillas de tarea; en las de ticket queda nulo.
  estimatedHours Float?     @map("estimated_hours")
  /// Checklists en borrador: `[{ title, items: string[] }]` (ver src/lib/checklist.ts)
  checklist      Json       @default("[]")

  createdById    String     @map("created_by_id")
  createdBy      User       @relation("TemplateCreatedBy", fields: [createdById], references: [id])

  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  @@index([entityType, name])
  @@map("templates")
}

// Vínculos de bóveda polimórficos: reemplazan a TicketVaultEntry y
// ProjectVaultEntry. La relación con VaultEntry sigue siendo clave foránea
// real, así que borrar una entrada de bóveda arrastra sus vínculos.
model VaultLink {
  entityType   EntityType @map("entity_type")
  entityId     String     @map("entity_id")
  vaultEntryId String     @map("vault_entry_id")

  addedAt      DateTime   @default(now()) @map("added_at")

  vaultEntry   VaultEntry @relation(fields: [vaultEntryId], references: [id], onDelete: Cascade)

  @@id([entityType, entityId, vaultEntryId])
  @@index([vaultEntryId])
  @@map("vault_links")
}

// Acceso explícito de un usuario a un módulo. Pisa lo que diga su perfil.
model AppAccess {
  userId String      @map("user_id")
  app    AppKey
  level  AccessLevel @default(SIN_ACCESO)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, app])
  @@map("app_access")
}

// Perfil reutilizable: "Dirección", "Soporte", "Comercial"… El administrador
// asigna un perfil y se expande a los niveles de cada módulo, en vez de
// configurar app por app.
model AccessProfile {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  /// Niveles por módulo: `{ "TICKETS": "GESTOR", "CRM": "LECTURA" }`.
  /// Los módulos ausentes equivalen a SIN_ACCESO.
  grants      Json     @default("{}")
  /// Los perfiles del sistema no se pueden borrar desde la interfaz.
  isSystem    Boolean  @default(false) @map("is_system")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       User[]

  @@map("access_profiles")
}

model CommentReaction {
  commentId String       @map("comment_id")
  userId    String       @map("user_id")
  type      ReactionType

  createdAt DateTime     @default(now()) @map("created_at")

  comment   Comment      @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User         @relation("CommentReactionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@map("comment_reactions")
}

// ─── Bóveda ──────────────────────────────────────────────────────────────────

model VaultEntry {
  id          String   @id @default(cuid())
  title       String
  username    String?
  password    String   // AES-256-GCM cifrado: "<iv_hex>:<tag_hex>:<cipher_hex>"
  url         String?
  notes       String?  @db.Text

  companyId   String?  @map("company_id")
  siteId      String?  @map("site_id")
  serviceId   String?  @map("service_id")
  createdById String   @map("created_by_id")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company     Company?   @relation(fields: [companyId], references: [id])
  site        Site?      @relation(fields: [siteId], references: [id])
  service     Service?   @relation(fields: [serviceId], references: [id])
  createdBy   User       @relation("VaultCreatedBy", fields: [createdById], references: [id])
  sharedWith  VaultShare[]
  projects    ProjectVaultEntry[]
  tickets     TicketVaultEntry[]
  links       VaultLink[]

  @@map("vault_entries")
}

model TicketVaultEntry {
  ticketId     String     @map("ticket_id")
  vaultEntryId String     @map("vault_entry_id")

  ticket       Ticket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  vaultEntry   VaultEntry @relation(fields: [vaultEntryId], references: [id], onDelete: Cascade)

  addedAt      DateTime   @default(now()) @map("added_at")

  @@id([ticketId, vaultEntryId])
  @@map("ticket_vault_entries")
}

model VaultShare {
  id           String     @id @default(cuid())
  vaultEntryId String     @map("vault_entry_id")
  userId       String     @map("user_id")

  vaultEntry   VaultEntry @relation(fields: [vaultEntryId], references: [id], onDelete: Cascade)
  user         User       @relation("VaultSharedWith", fields: [userId], references: [id], onDelete: Cascade)

  createdAt    DateTime   @default(now()) @map("created_at")

  @@unique([vaultEntryId, userId])
  @@map("vault_shares")
}

model Site {
  id            String   @id @default(cuid())
  name          String
  domain        String
  documentation String?  @db.Text
  architecture  String?  @db.Text
  isActive      Boolean  @default(true) @map("is_active")

  companyId     String   @map("company_id")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tickets      Ticket[]
  vaultEntries VaultEntry[]

  @@map("sites")
}

model Notification {
  id        String    @id @default(cuid())
  type      String
  title     String
  message   String
  link      String?
  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")

  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

// Webhooks personales: cada usuario puede enviar SUS propias notificaciones a
// apps externas (Zapier, Make, n8n, Slack, etc.). `events` guarda las categorías
// suscritas: "tickets" | "tasks" | "comments" | "mentions".
model UserWebhook {
  id          String   @id @default(cuid())
  label       String?
  url         String
  secret      String?
  events      String[] @default([])
  isActive    Boolean  @default(true) @map("is_active")

  lastStatus  Int?      @map("last_status")
  lastError   String?   @map("last_error")
  lastSentAt  DateTime? @map("last_sent_at")

  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("user_webhooks")
}

// ─── Checklists ───────────────────────────────────────────────────────────────

// Un ticket/tarea puede tener varios checklists, cada uno con su título. Los
// ítems cuelgan del checklist, no del ticket/tarea.

model TicketChecklist {
  id          String   @id @default(cuid())
  title       String
  position    Int      @default(0)

  ticketId    String   @map("ticket_id")
  createdById String   @map("created_by_id")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  ticket      Ticket                @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  createdBy   User                  @relation(fields: [createdById], references: [id])
  items       TicketChecklistItem[]

  @@index([ticketId])
  @@map("ticket_checklists")
}

model TicketChecklistItem {
  id          String   @id @default(cuid())
  title       String
  isChecked   Boolean  @default(false) @map("is_checked")
  position    Int      @default(0)

  checklistId String   @map("checklist_id")
  createdById String   @map("created_by_id")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  checklist   TicketChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  createdBy   User            @relation(fields: [createdById], references: [id])

  @@index([checklistId])
  @@map("ticket_checklist_items")
}

model TaskChecklist {
  id          String   @id @default(cuid())
  title       String
  position    Int      @default(0)

  taskId      String   @map("task_id")
  createdById String   @map("created_by_id")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  task        Task                @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdBy   User                @relation(fields: [createdById], references: [id])
  items       TaskChecklistItem[]

  @@index([taskId])
  @@map("task_checklists")
}

model TaskChecklistItem {
  id          String   @id @default(cuid())
  title       String
  isChecked   Boolean  @default(false) @map("is_checked")
  position    Int      @default(0)

  checklistId String   @map("checklist_id")
  createdById String   @map("created_by_id")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  checklist   TaskChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  createdBy   User          @relation(fields: [createdById], references: [id])

  @@index([checklistId])
  @@map("task_checklist_items")
}
