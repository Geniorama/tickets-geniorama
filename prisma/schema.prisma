generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  ADMINISTRADOR
  COLABORADOR
  CLIENTE
}

enum CompanyType {
  AGENCIA
  EMPRESA
}

// Etapa comercial de una organización. Reutilizar `Company` en vez de crear una
// entidad «Lead» aparte evita la conversión con migración de datos en cada
// venta cerrada: el prospecto que se gana simplemente pasa a CLIENTE y conserva
// su historial, sus contactos y, luego, sus proyectos y tickets.
enum AccountStage {
  LEAD
  PROSPECTO
  CLIENTE
  INACTIVO
}

/// Etapas del pipeline de venta. GANADA y PERDIDA son terminales: al llegar a
/// una de las dos se sella `closedAt` y la oportunidad sale del tablero activo.
enum DealStage {
  NUEVA
  CONTACTADA
  PROPUESTA
  NEGOCIACION
  GANADA
  PERDIDA
}

/// Cómo ocurrió una interacción comercial.
enum ActivityType {
  NOTA
  LLAMADA
  CORREO
  REUNION
  WHATSAPP
}

enum PlanType {
  BOLSA_HORAS
  SOPORTE_MENSUAL
}

enum TicketStatus {
  POR_ASIGNAR
  ABIERTO
  EN_PROGRESO
  EN_REVISION
  CERRADO
}

enum Priority {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

enum ProjectStatus {
  PLANIFICACION
  EN_DESARROLLO
  EN_REVISION
  COMPLETADO
  PAUSADO
}

enum TaskStatus {
  PENDIENTE
  EN_PROGRESO
  EN_REVISION
  COMPLETADO
}

enum RecurrenceFrequency {
  DIARIA
  SEMANAL
  MENSUAL
}

enum ServiceType {
  DOMINIO
  HOSTING
  CORREO
  SSL
  MANTENIMIENTO
  OTRO
}

enum ServiceProvider {
  GENIORAMA
  EXTERNO
}

enum ReactionType {
  LIKE
  GENIO
  DISLIKE
  REVISANDO
}

// ─── Permisos por app (Fase 1) ───────────────────────────────────────────────

// Los módulos a los que se concede acceso. `ADMIN` agrupa la administración
// (usuarios, empresas, planes, estadísticas). Los que aún no existen se
// declaran igual para poder preparar perfiles; el registro de
// src/lib/access/apps.ts marca cuáles están construidos.
enum AppKey {
  TICKETS
  PROYECTOS
  INFRAESTRUCTURA
  PORTAL
  ADMIN
  CRM
}

// Nivel dentro de un módulo. Es independiente del rol: el rol delimita QUÉ
// registros ve alguien (su frontera de datos) y el nivel, QUÉ puede hacer con
// los que ya ve. Un nivel nunca amplía la frontera del rol.
enum AccessLevel {
  SIN_ACCESO
  LECTURA
  MIEMBRO
  GESTOR
}

enum SchedulingLinkCategory {
  PROYECTOS
  SOPORTE
}

// Núcleo compartido: identifica a qué entidad pertenece un registro polimórfico
// (comentarios, y más adelante adjuntos, checklists, tiempo y actividad).
// Al agregar una app nueva se añade su valor aquí.
enum EntityType {
  TICKET
  TASK
  PROJECT
}

// ─── Models ──────────────────────────────────────────────────────────────────

model Company {
  id              String      @id @default(cuid())
  name            String
  type            CompanyType @default(EMPRESA) @map("type")
  taxId           String?     @map("tax_id")
  logoUrl         String?     @map("logo_url")
  logoStoragePath String?     @map("logo_storage_path")
  isActive        Boolean     @default(true) @map("is_active")

  // ── CRM ────────────────────────────────────────────────────────────────────
  stage           AccountStage @default(CLIENTE)
  /// Responsable comercial de la cuenta.
  ownerId         String?      @map("owner_id")
  /// De dónde salió: referido, web, evento…
  source          String?

  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  parentId     String?   @map("parent_id")
  parent       Company?  @relation("AgencySubCompanies", fields: [parentId], references: [id])
  subCompanies Company[] @relation("AgencySubCompanies")

  users        User[]
  plans        Plan[]
  projects     Project[]
  services     Service[]
  sites        Site[]
  vaultEntries VaultEntry[]
  owner        User?     @relation("AccountOwner", fields: [ownerId], references: [id])
  contacts     Contact[]
  deals        Deal[]
  crmActivities CrmActivity[]

  @@index([stage])
  @@map("companies")
}

// Persona de contacto en una cuenta. A diferencia de `User`, no accede al
// sistema: es la agenda comercial. Si más adelante se le invita al portal, se
// enlaza con su `User` en vez de duplicar la persona.
model Contact {
  id        String   @id @default(cuid())
  /// Nombre de pila. Es lo único obligatorio: a veces se apunta a alguien en
  /// una llamada sabiendo solo cómo se llama.
  firstName String   @map("first_name")
  /// Apellidos, los dos juntos si los hay. Opcional por lo mismo.
  lastName  String?  @map("last_name")
  email     String?
  phone     String?
  /// Cargo dentro de la empresa.
  position  String?
  notes     String?  @db.Text
  /// El contacto principal de la cuenta; solo uno por empresa.
  isPrimary Boolean  @default(false) @map("is_primary")
  isActive  Boolean  @default(true)  @map("is_active")

  companyId String   @map("company_id")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Se rellena si al contacto se le da acceso al portal.
  userId    String?  @unique @map("user_id")
  user      User?    @relation("ContactUser", fields: [userId], references: [id], onDelete: SetNull)

  createdById String   @map("created_by_id")
  createdBy   User     @relation("ContactCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  deals         Deal[]
  crmActivities CrmActivity[]

  @@index([companyId, isPrimary])
  // La agenda se lee y se ordena por apellido, como cualquier agenda.
  @@index([lastName, firstName])
  @@map("contacts")
}

// Una oportunidad de venta concreta sobre una cuenta. La cuenta responde «con
// quién hablamos»; la oportunidad, «qué estamos vendiendo y por cuánto». Por eso
// una misma empresa puede tener varias abiertas a la vez.
model Deal {
  id     String    @id @default(cuid())
  title  String
  stage  DealStage @default(NUEVA)
  /// Valor estimado. Como en `Service.price`, en la moneda de la agencia.
  amount Float?

  /// Cuándo se espera cerrarla; sirve para el pronóstico del mes.
  expectedCloseAt DateTime? @map("expected_close_at")
  /// Se sella al pasar a GANADA o PERDIDA, y se borra si se reabre.
  closedAt        DateTime? @map("closed_at")
  /// Por qué se perdió. Lo que más enseña del pipeline con el tiempo.
  lostReason      String?   @map("lost_reason")

  notes String? @db.Text

  companyId String  @map("company_id")
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Comercial que la lleva.
  ownerId String? @map("owner_id")
  owner   User?   @relation("DealOwner", fields: [ownerId], references: [id])

  /// Con quién se está hablando dentro de la cuenta.
  contactId String?  @map("contact_id")
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  createdById String @map("created_by_id")
  createdBy   User   @relation("DealCreatedBy", fields: [createdById], references: [id])

  activities CrmActivity[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([stage])
  @@index([companyId])
  @@index([ownerId, stage])
  @@map("deals")
}

// Lo que pasó con una cuenta: una llamada, un correo, una reunión, una nota.
// Es el historial que hace que retomar una conversación tres meses después no
// dependa de la memoria de nadie.
model CrmActivity {
  id      String       @id @default(cuid())
  type    ActivityType @default(NOTA)
  /// Qué pasó, en una línea.
  summary String
  notes   String?      @db.Text
  /// Cuándo ocurrió de verdad, que no es cuándo se apuntó.
  occurredAt DateTime  @map("occurred_at")

  companyId String  @map("company_id")
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Si la interacción fue sobre una oportunidad concreta.
  dealId String? @map("deal_id")
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  contactId String?  @map("contact_id")
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  createdById String @map("created_by_id")
  createdBy   User   @relation("CrmActivityCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([companyId, occurredAt])
  @@index([dealId, occurredAt])
  @@map("crm_activities")
}

model User {
  id                String   @id @default(cuid())
  name              String
  email             String   @unique
  passwordHash      String   @map("password_hash")
  role              Role     @default(CLIENTE)
  cargo             String?
  area              String?
  bio               String?  @db.Text
  avatarUrl         String?  @map("avatar_url")
  avatarStoragePath String?  @map("avatar_storage_path")
  isProjectManager  Boolean  @default(false) @map("is_project_manager")
  isSupportAgent    Boolean  @default(false) @map("is_support_agent")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  companies       Company[]
  schedulingLinks SchedulingLink[]

  createdTickets        Ticket[]             @relation("CreatedBy")
  assignedTickets       Ticket[]             @relation("AssignedTo")
  reviewingTickets      Ticket[]             @relation("TicketReviewers")
  clientTickets         Ticket[]             @relation("TicketClient")
  resetTokens           PasswordResetToken[]
  managedProjects       Project[]            @relation("ProjectManager")
  createdProjects       Project[]            @relation("ProjectCreatedBy")
  assignedTasks         Task[]               @relation("TaskAssignedTo")
  reviewingTasks        Task[]               @relation("TaskReviewers")
  createdTasks          Task[]               @relation("TaskCreatedBy")
  createdServices       Service[]            @relation("ServiceCreatedBy")
  createdVaultEntries   VaultEntry[]         @relation("VaultCreatedBy")
  vaultShares           VaultShare[]         @relation("VaultSharedWith")
  projectMemberships    ProjectMember[]
  projectFavorites      ProjectFavorite[]
  // Núcleo compartido
  authoredComments      Comment[]            @relation("CommentAuthor")
  commentReactions      CommentReaction[]    @relation("CommentReactionUser")
  uploadedAttachments   Attachment[]         @relation("AttachmentUploadedBy")
  createdChecklists     Checklist[]          @relation("ChecklistCreatedBy")
  createdChecklistItems ChecklistItem[]      @relation("ChecklistItemCreatedBy")
  timeEntries           TimeEntry[]          @relation("TimeEntryUser")
  createdTemplates      Template[]           @relation("TemplateCreatedBy")

  // Permisos por app
  profileId                  String?                 @map("profile_id")
  profile                    AccessProfile?          @relation(fields: [profileId], references: [id])
  appAccess                  AppAccess[]
  notifications              Notification[]
  webhooks                   UserWebhook[]
  createdRecurringTemplates  RecurringTaskTemplate[] @relation("RecurringCreatedBy")
  assignedRecurringTemplates RecurringTaskTemplate[] @relation("RecurringAssignedTo")
  briefRoutings              BriefRouting[]          @relation("BriefRoutingAssignedTo")

  // Integraciones externas
  createdHooks   Hook[]   @relation("HookCreatedBy")
  apiKeys        ApiKey[] @relation("ApiKeyUser")
  createdApiKeys ApiKey[] @relation("ApiKeyCreatedBy")

  // CRM
  ownedAccounts   Company[] @relation("AccountOwner")
  contactProfile  Contact?  @relation("ContactUser")
  createdContacts Contact[] @relation("ContactCreatedBy")
  ownedDeals      Deal[]    @relation("DealOwner")
  createdDeals    Deal[]    @relation("DealCreatedBy")
  crmActivities   CrmActivity[] @relation("CrmActivityCreatedBy")

  @@map("users")
}

model Ticket {
  id          String       @id @default(cuid())
  title       String
  description String
  status      TicketStatus @default(ABIERTO)
  priority    Priority     @default(MEDIA)
  category    String?
  isDraft     Boolean      @default(false) @map("is_draft")

  createdById  String  @map("created_by_id")
  assignedToId String? @map("assigned_to_id")
  clientId     String? @map("client_id")
  planId       String? @map("plan_id")
  siteId       String? @map("site_id")

  prefix String?
  number Int     @default(0)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  dueDate   DateTime? @map("due_date")

  createdBy  User   @relation("CreatedBy", fields: [createdById], references: [id])
  assignedTo User?  @relation("AssignedTo", fields: [assignedToId], references: [id])
  reviewers  User[] @relation("TicketReviewers")
  client     User?  @relation("TicketClient", fields: [clientId], references: [id])
  plan       Plan?  @relation(fields: [planId], references: [id])
  site       Site?  @relation(fields: [siteId], references: [id])

  @@map("tickets")
}

model Plan {
  id           String    @id @default(cuid())
  name         String
  type         PlanType
  totalHours   Float?    @map("total_hours")
  durationDays Int?      @map("duration_days")
  startedAt    DateTime  @default(now()) @map("started_at")
  expiresAt    DateTime? @map("expires_at")
  isActive     Boolean   @default(true) @map("is_active")

  companyId String  @map("company_id")
  company   Company @relation(fields: [companyId], references: [id])

  tickets Ticket[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("plans")
}

// Links de agendamiento de llamadas de un colaborador (Google Calendar, Calendly, etc.).
// Cada link tiene título, descripción opcional y una categoría que determina si aplica a
// proyectos (tareas) o a soporte (tickets). El agendamiento ocurre en el link externo.
model SchedulingLink {
  id          String                 @id @default(cuid())
  title       String
  description String?
  url         String
  category    SchedulingLinkCategory
  position    Int                    @default(0)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("scheduling_links")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String        @db.Text
  status      ProjectStatus @default(PLANIFICACION)
  isActive    Boolean       @default(true) @map("is_active")
  isPrivate   Boolean       @default(false) @map("is_private")
  startDate   DateTime?     @map("start_date")
  dueDate     DateTime?     @map("due_date")

  companyId   String? @map("company_id")
  managerId   String? @map("manager_id")
  createdById String  @map("created_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company            Company?                @relation(fields: [companyId], references: [id])
  manager            User?                   @relation("ProjectManager", fields: [managerId], references: [id])
  createdBy          User                    @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  tasks              Task[]
  members            ProjectMember[]
  favorites          ProjectFavorite[]
  recurringTemplates RecurringTaskTemplate[]
  hooks              Hook[]

  @@map("projects")
}

model ProjectFavorite {
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@map("project_favorites")
}

model ProjectMember {
  projectId String @map("project_id")
  userId    String @map("user_id")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  addedAt DateTime @default(now()) @map("added_at")

  @@id([projectId, userId])
  @@map("project_members")
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String
  status      TaskStatus @default(PENDIENTE)
  priority    Priority   @default(MEDIA)
  category    String?
  isDraft     Boolean    @default(false) @map("is_draft")

  number Int @default(0)

  /// Identificador del sistema externo que originó la tarea (p. ej. el id de
  /// ejecución de n8n). Es único para que un reintento del webhook no cree un
  /// duplicado: la integración busca por aquí antes de insertar.
  externalRef String? @unique @map("external_ref")

  startDate      DateTime? @map("start_date")
  startTime      String?   @map("start_time")
  dueDate        DateTime? @map("due_date")
  endTime        String?   @map("end_time")
  estimatedHours Float?    @map("estimated_hours")

  projectId           String? @map("project_id")
  assignedToId        String? @map("assigned_to_id")
  createdById         String  @map("created_by_id")
  recurringTemplateId String? @map("recurring_template_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project           Project?               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedTo        User?                  @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  reviewers         User[]                 @relation("TaskReviewers")
  createdBy         User                   @relation("TaskCreatedBy", fields: [createdById], references: [id])
  recurringTemplate RecurringTaskTemplate? @relation(fields: [recurringTemplateId], references: [id], onDelete: SetNull)

  @@map("tasks")
}

model RecurringTaskTemplate {
  id             String   @id @default(cuid())
  title          String
  description    String   @db.Text
  priority       Priority @default(MEDIA)
  category       String?
  estimatedHours Float?   @map("estimated_hours")
  /// Checklists en borrador: `[{ title, items: string[] }]` (ver src/lib/checklist.ts)
  checklist      Json     @default("[]")

  projectId    String? @map("project_id")
  assignedToId String? @map("assigned_to_id")
  createdById  String  @map("created_by_id")

  frequency  RecurrenceFrequency
  interval   Int                 @default(1)
  daysOfWeek String?             @map("days_of_week")
  dayOfMonth Int?                @map("day_of_month")

  startDate DateTime  @map("start_date")
  endDate   DateTime? @map("end_date")
  nextRunAt DateTime  @map("next_run_at")
  lastRunAt DateTime? @map("last_run_at")
  isActive  Boolean   @default(true) @map("is_active")

  dueDateOffsetDays Int @default(0) @map("due_date_offset_days")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project        Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignedTo     User?    @relation("RecurringAssignedTo", fields: [assignedToId], references: [id])
  createdBy      User     @relation("RecurringCreatedBy", fields: [createdById], references: [id])
  generatedTasks Task[]

  @@index([isActive, nextRunAt])
  @@map("recurring_task_templates")
}

// Enrutamiento de briefs entrantes (n8n → /api/integrations/brief).
//
// El cliente diligencia un brief en n8n y este llega al webhook con un
// `briefType`. Esta tabla dice a quién se le asigna la tarea resultante y con
// qué valores por defecto. El proyecto NO vive aquí: n8n siempre manda el
// `projectId` en el payload, así que un mismo tipo de brief puede caer en
// proyectos distintos sin tocar la configuración.
model BriefRouting {
  id             String   @id @default(cuid())
  /// Valor que manda n8n en `briefType`. Se normaliza a minúsculas al guardar
  /// y al buscar, para que "Web" y "web" sean lo mismo.
  briefType      String   @unique @map("brief_type")
  /// Nombre legible para la pantalla de administración ("Brief de sitio web").
  label          String
  assignedToId   String   @map("assigned_to_id")
  priority       Priority @default(MEDIA)
  category       String?
  estimatedHours Float?   @map("estimated_hours")

  /// Plazo de entrega en **días hábiles** desde que entra el brief. Null = sin
  /// plazo automático (la tarea nace sin fecha límite, salvo que n8n mande una).
  dueDays Int?    @map("due_days")
  /// Hora límite del día de entrega, "HH:MM". Se guarda en `Task.endTime`, que
  /// es como el resto de la app almacena la hora: aparte de la fecha, para no
  /// arrastrar la zona horaria dentro del DateTime.
  dueTime String? @map("due_time")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  assignedTo User @relation("BriefRoutingAssignedTo", fields: [assignedToId], references: [id])

  @@map("brief_routings")
}

model Service {
  id          String          @id @default(cuid())
  name        String
  type        ServiceType
  provider    ServiceProvider @default(GENIORAMA)
  description String?
  dueDate     DateTime?       @map("due_date")
  price       Float?
  notes       String?
  isActive    Boolean         @default(true) @map("is_active")

  companyId   String @map("company_id")
  createdById String @map("created_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("ServiceCreatedBy", fields: [createdById], references: [id])
  vaultEntries VaultEntry[]

  @@map("services")
}

// ─── Núcleo compartido ───────────────────────────────────────────────────────
//
// Comentarios polimórficos: una sola tabla para tickets, tareas y lo que venga
// (negocios del CRM, facturas, documentos).
//
// Prisma no puede garantizar integridad referencial sobre `entityId`: no hay
// clave foránea ni borrado en cascada desde el ticket o la tarea. Ese contrato
// vive en src/lib/comments.ts — usa `deleteCommentsFor()` en todo camino que
// borre una entidad comentable.

model Comment {
  id         String     @id @default(cuid())
  entityType EntityType @map("entity_type")
  entityId   String     @map("entity_id")

  body       String
  isInternal Boolean @default(false) @map("is_internal")

  // Adjunto inline heredado del esquema viejo. Se conserva para no perder
  // comentarios históricos; los adjuntos nuevos van en CommentAttachment.
  attachmentType        String? @map("attachment_type")
  attachmentUrl         String? @map("attachment_url")
  attachmentName        String? @map("attachment_name")
  attachmentStoragePath String? @map("attachment_storage_path")

  authorId String @map("author_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  author      User                @relation("CommentAuthor", fields: [authorId], references: [id])
  attachments CommentAttachment[]
  reactions   CommentReaction[]

  @@index([entityType, entityId, createdAt])
  @@index([authorId])
  @@map("comments")
}

model CommentAttachment {
  id          String  @id @default(cuid())
  type        String // "link" | "file"
  url         String
  name        String?
  storagePath String? @map("storage_path") // null para enlaces

  commentId String   @map("comment_id")
  createdAt DateTime @default(now()) @map("created_at")

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([commentId])
  @@map("comment_attachments")
}

// Adjuntos polimórficos para cualquier entidad.
//
// Unifica además tres convenciones distintas para distinguir un enlace de un
// archivo: los tickets no tenían enlaces, los proyectos usaban la columna
// `type`, y las tareas marcaban el enlace con el centinela
// `storagePath = "link"`. Aquí manda `type`, y `storagePath` es null en enlaces.
//
// Igual que con los comentarios, no hay clave foránea sobre `entityId`: usa
// `deleteAttachmentsFor()` en todo camino que borre una entidad con adjuntos.
model Attachment {
  id         String     @id @default(cuid())
  entityType EntityType @map("entity_type")
  entityId   String     @map("entity_id")

  type        String  @default("file") // "file" | "link"
  fileUrl     String  @map("file_url")
  fileName    String  @map("file_name")
  storagePath String? @map("storage_path") // null en enlaces
  position    Int     @default(0)

  uploadedById String   @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  uploadedBy User @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id])

  @@index([entityType, entityId, position, createdAt])
  @@index([uploadedById])
  @@map("attachments")
}

// Checklists polimórficos para cualquier entidad.
//
// Solo la relación con la entidad es polimórfica. Los ítems mantienen clave
// foránea real hacia el checklist, así que siguen cayendo en cascada; lo que
// hay que borrar a mano es el checklist cuando se elimina su ticket o tarea
// (`deleteChecklistsFor()`).
model Checklist {
  id         String     @id @default(cuid())
  entityType EntityType @map("entity_type")
  entityId   String     @map("entity_id")

  title    String
  position Int    @default(0)

  createdById String @map("created_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  createdBy User            @relation("ChecklistCreatedBy", fields: [createdById], references: [id])
  items     ChecklistItem[]

  @@index([entityType, entityId, position])
  @@map("checklists")
}

model ChecklistItem {
  id        String  @id @default(cuid())
  title     String
  isChecked Boolean @default(false) @map("is_checked")
  position  Int     @default(0)

  checklistId String @map("checklist_id")
  createdById String @map("created_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  checklist Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  createdBy User      @relation("ChecklistItemCreatedBy", fields: [createdById], references: [id])

  @@index([checklistId, position])
  @@map("checklist_items")
}

// Registros de tiempo polimórficos: una sola implementación del cronómetro
// para tickets, tareas y lo que venga.
//
// Es el modelo que alimentará la facturación: el consumo de horas de un plan
// se calcula sumando las entradas cerradas de los tickets de ese plan
// (`getPlanUsedHours`). Una entrada con `stoppedAt` nulo es un contador en
// marcha y no cuenta como tiempo consumido.
model TimeEntry {
  id         String     @id @default(cuid())
  entityType EntityType @map("entity_type")
  entityId   String     @map("entity_id")

  startedAt DateTime  @map("started_at")
  stoppedAt DateTime? @map("stopped_at")

  userId String @map("user_id")
  user   User   @relation("TimeEntryUser", fields: [userId], references: [id])

  @@index([entityType, entityId, startedAt])
  // El contador flotante busca la entrada abierta del usuario en cada carga.
  @@index([userId, stoppedAt])
  @@map("time_entries")
}

// Plantillas polimórficas.
// A diferencia del resto del núcleo, `entityType` no apunta a una entidad
// concreta sino que indica **qué crea** la plantilla. Por eso no hay entityId.
model Template {
  id         String     @id @default(cuid())
  entityType EntityType @map("entity_type")

  name           String
  title          String
  description    String   @db.Text
  priority       Priority @default(MEDIA)
  category       String?
  /// Solo lo usan las plantillas de tarea; en las de ticket queda nulo.
  estimatedHours Float?   @map("estimated_hours")
  /// Checklists en borrador: `[{ title, items: string[] }]` (ver src/lib/checklist.ts)
  checklist      Json     @default("[]")

  createdById String @map("created_by_id")
  createdBy   User   @relation("TemplateCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([entityType, name])
  @@map("templates")
}

// Vínculos de bóveda polimórficos. La relación con VaultEntry es clave foránea
// real, así que borrar una entrada de bóveda arrastra sus vínculos.
model VaultLink {
  entityType   EntityType @map("entity_type")
  entityId     String     @map("entity_id")
  vaultEntryId String     @map("vault_entry_id")

  addedAt DateTime @default(now()) @map("added_at")

  vaultEntry VaultEntry @relation(fields: [vaultEntryId], references: [id], onDelete: Cascade)

  @@id([entityType, entityId, vaultEntryId])
  @@index([vaultEntryId])
  @@map("vault_links")
}

// Acceso explícito de un usuario a un módulo. Pisa lo que diga su perfil.
model AppAccess {
  userId String      @map("user_id")
  app    AppKey
  level  AccessLevel @default(SIN_ACCESO)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, app])
  @@map("app_access")
}

// Perfil reutilizable: "Dirección", "Soporte", "Comercial"… El administrador
// asigna un perfil y se expande a los niveles de cada módulo, en vez de
// configurar app por app.
model AccessProfile {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  /// Niveles por módulo: `{ "TICKETS": "GESTOR", "CRM": "LECTURA" }`.
  /// Los módulos ausentes equivalen a SIN_ACCESO.
  grants      Json    @default("{}")
  /// Los perfiles del sistema no se pueden borrar desde la interfaz.
  isSystem    Boolean @default(false) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("access_profiles")
}

model CommentReaction {
  commentId String       @map("comment_id")
  userId    String       @map("user_id")
  type      ReactionType

  createdAt DateTime @default(now()) @map("created_at")

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation("CommentReactionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@map("comment_reactions")
}

// ─── Bóveda ──────────────────────────────────────────────────────────────────

model VaultEntry {
  id       String  @id @default(cuid())
  title    String
  username String?
  password String // AES-256-GCM cifrado: "<iv_hex>:<tag_hex>:<cipher_hex>"
  url      String?
  notes    String? @db.Text

  companyId   String? @map("company_id")
  siteId      String? @map("site_id")
  serviceId   String? @map("service_id")
  createdById String  @map("created_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company    Company?     @relation(fields: [companyId], references: [id])
  site       Site?        @relation(fields: [siteId], references: [id])
  service    Service?     @relation(fields: [serviceId], references: [id])
  createdBy  User         @relation("VaultCreatedBy", fields: [createdById], references: [id])
  sharedWith VaultShare[]
  links      VaultLink[]

  @@map("vault_entries")
}

model VaultShare {
  id           String @id @default(cuid())
  vaultEntryId String @map("vault_entry_id")
  userId       String @map("user_id")

  vaultEntry VaultEntry @relation(fields: [vaultEntryId], references: [id], onDelete: Cascade)
  user       User       @relation("VaultSharedWith", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([vaultEntryId, userId])
  @@map("vault_shares")
}

model Site {
  id            String  @id @default(cuid())
  name          String
  domain        String
  documentation String? @db.Text
  architecture  String? @db.Text
  isActive      Boolean @default(true) @map("is_active")

  companyId String @map("company_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tickets      Ticket[]
  vaultEntries VaultEntry[]

  @@map("sites")
}

model Notification {
  id      String    @id @default(cuid())
  type    String
  title   String
  message String
  link    String?
  isRead  Boolean   @default(false) @map("is_read")
  readAt  DateTime? @map("read_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

// Webhooks personales: cada usuario puede enviar SUS propias notificaciones a
// apps externas (Zapier, Make, n8n, Slack, etc.). `events` guarda las categorías
// suscritas: "tickets" | "tasks" | "comments" | "mentions".
model UserWebhook {
  id       String   @id @default(cuid())
  label    String?
  url      String
  secret   String?
  events   String[] @default([])
  isActive Boolean  @default(true) @map("is_active")

  lastStatus Int?      @map("last_status")
  lastError  String?   @map("last_error")
  lastSentAt DateTime? @map("last_sent_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("user_webhooks")
}

// ─── Checklists ───────────────────────────────────────────────────────────────

// Un ticket/tarea puede tener varios checklists, cada uno con su título. Los
// ítems cuelgan del checklist, no del ticket/tarea.

// ─── Integraciones externas ───────────────────────────────────────────────────

/// Alcance de un hook: toda la organización, o un solo proyecto.
///
/// `ORG` recibe todo lo que ocurre en la plataforma; `PROJECT` solo los eventos
/// de su proyecto (sus tareas y sus comentarios). Los tickets no cuelgan de un
/// proyecto, así que únicamente llegan a los hooks `ORG`.
enum HookScope {
  ORG
  PROJECT
}

/// Un destino externo suscrito a los eventos de la plataforma.
///
/// Sustituye a la integración de WhatsApp que vivía dentro de la app: en vez de
/// construir cada canal aquí dentro, la plataforma cuenta lo que pasa y quien
/// quiera (n8n, Make, Zapier, un servicio propio) decide qué hacer con ello.
///
/// `events` guarda los eventos suscritos con la forma `recurso.accion`
/// («ticket.created», «task.status_changed»…). El catálogo vive en
/// src/lib/hooks/events.ts, no en la base: añadir un evento no es una migración.
model Hook {
  id        String    @id @default(cuid())
  label     String
  url       String
  /// Secreto de firma. Se genera al crear el hook y nunca cambia solo: quien
  /// recibe verifica con él la cabecera `X-Geniorama-Signature`.
  secret    String
  events    String[]  @default([])
  scope     HookScope @default(ORG)
  /// Obligatorio cuando `scope = PROJECT`; null en los hooks de organización.
  projectId String?   @map("project_id")
  isActive  Boolean   @default(true) @map("is_active")

  // Último resultado, para que la pantalla diga si el destino está vivo sin
  // tener que abrir el historial de entregas.
  lastStatus Int?      @map("last_status")
  lastError  String?   @map("last_error")
  lastSentAt DateTime? @map("last_sent_at")

  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project    Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy  User           @relation("HookCreatedBy", fields: [createdById], references: [id])
  deliveries HookDelivery[]

  @@index([isActive, scope])
  @@index([projectId])
  @@map("hooks")
}

/// Registro de cada intento de entrega.
///
/// Sin esto, depurar una integración es adivinar: el equipo necesita ver qué
/// se mandó y qué contestó el otro lado. Se conservan 14 días (ver
/// src/lib/hooks/dispatch.ts), suficiente para diagnosticar y poco para pesar.
model HookDelivery {
  id         String  @id @default(cuid())
  hookId     String  @map("hook_id")
  event      String
  payload    Json
  /// Código HTTP de la respuesta, o null si ni siquiera hubo conexión.
  status     Int?
  error      String?
  durationMs Int?    @map("duration_ms")
  /// Número de intentos gastados (1 = entró a la primera).
  attempts   Int     @default(1)

  createdAt DateTime @default(now()) @map("created_at")

  hook Hook @relation(fields: [hookId], references: [id], onDelete: Cascade)

  @@index([hookId, createdAt(sort: Desc)])
  @@map("hook_deliveries")
}

/// Llave para entrar a la API pública (`/api/v1/...`).
///
/// El token completo solo se ve una vez, al crearlo: en la base queda su hash
/// SHA-256. `prefix` es la parte visible («gnr_a1b2c3d4»), que permite
/// identificar y revocar una llave sin conocerla.
///
/// Toda llave escribe **en nombre de un usuario** (`userId`): así lo que entra
/// por la API tiene autor y respeta la misma frontera de datos que la
/// plataforma, en vez de ser un superusuario anónimo.
model ApiKey {
  id         String    @id @default(cuid())
  label      String
  prefix     String    @unique
  tokenHash  String    @unique @map("token_hash")
  /// "read" | "write" | "act_as" (ver src/lib/api/keys.ts).
  scopes     String[]  @default([])
  isActive   Boolean   @default(true) @map("is_active")
  expiresAt  DateTime? @map("expires_at")
  lastUsedAt DateTime? @map("last_used_at")

  userId      String @map("user_id")
  createdById String @map("created_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User @relation("ApiKeyUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User @relation("ApiKeyCreatedBy", fields: [createdById], references: [id])

  @@index([userId])
  @@map("api_keys")
}
