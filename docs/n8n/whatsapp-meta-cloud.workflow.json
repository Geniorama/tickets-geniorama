{
  "name": "Geniorama — Agente de WhatsApp",
  "nodes": [
    {
      "parameters": {
        "updates": ["messages"]
      },
      "id": "wa-trigger",
      "name": "WhatsApp Trigger",
      "type": "n8n-nodes-base.whatsAppTrigger",
      "typeVersion": 1,
      "position": [0, 300],
      "webhookId": "geniorama-whatsapp",
      "credentials": {
        "whatsAppTriggerApi": { "id": "REEMPLAZAR", "name": "WhatsApp OAuth account" }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "has-message",
              "leftValue": "={{ $json.messages?.[0]?.id }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "wa-is-message",
      "name": "¿Es un mensaje entrante?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [240, 300],
      "notes": "El campo «messages» de Meta también entrega acuses de estado (sent, delivered, read), que llegan sin el array messages. Sin este filtro, cada respuesta del bot dispararía el flujo otra vez."
    },
    {
      "parameters": {
        "jsCode": "// Aplana el payload de Meta a los tres campos que espera la app.\nconst value = $('WhatsApp Trigger').first().json;\nconst msg = value.messages[0];\n\n// El agente solo entiende texto. Se rescatan además las respuestas a botones\n// y listas, que llegan en otra forma pero siguen siendo texto del usuario.\nlet text = '';\nif (msg.type === 'text') text = msg.text.body;\nelse if (msg.type === 'button') text = msg.button?.text ?? '';\nelse if (msg.type === 'interactive') {\n  text = msg.interactive?.button_reply?.title ?? msg.interactive?.list_reply?.title ?? '';\n}\n// Audio, imagen, ubicación o sticker: se manda vacío a propósito y la app\n// responde pidiendo texto, en vez de quedarse callada.\n\nreturn [{\n  json: {\n    from: msg.from,\n    text,\n    messageId: msg.id,\n    phoneNumberId: value.metadata.phone_number_id,\n  },\n}];"
      },
      "id": "wa-extract",
      "name": "Extraer mensaje",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://TU-DOMINIO/api/integrations/whatsapp",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ from: $json.from, text: $json.text, messageId: $json.messageId }) }}",
        "options": { "timeout": 90000 }
      },
      "id": "wa-agent",
      "name": "Agente Geniorama",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 220],
      "notes": "La app devuelve { ok, reply, phone, linked }. «reply» siempre trae texto presentable, incluso si algo falló del lado de la app.",
      "credentials": {
        "httpHeaderAuth": { "id": "REEMPLAZAR", "name": "Geniorama Tickets — Bearer" }
      }
    },
    {
      "parameters": {
        "operation": "send",
        "phoneNumberId": "={{ $('Extraer mensaje').item.json.phoneNumberId }}",
        "recipientPhoneNumber": "={{ $('Extraer mensaje').item.json.from }}",
        "textBody": "={{ $json.reply }}",
        "additionalFields": {},
        "requestOptions": {}
      },
      "id": "wa-send",
      "name": "Responder por WhatsApp",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [920, 220],
      "credentials": {
        "whatsAppApi": { "id": "REEMPLAZAR", "name": "WhatsApp account" }
      }
    }
  ],
  "connections": {
    "WhatsApp Trigger": {
      "main": [[{ "node": "¿Es un mensaje entrante?", "type": "main", "index": 0 }]]
    },
    "¿Es un mensaje entrante?": {
      "main": [[{ "node": "Extraer mensaje", "type": "main", "index": 0 }], []]
    },
    "Extraer mensaje": {
      "main": [[{ "node": "Agente Geniorama", "type": "main", "index": 0 }]]
    },
    "Agente Geniorama": {
      "main": [[{ "node": "Responder por WhatsApp", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
