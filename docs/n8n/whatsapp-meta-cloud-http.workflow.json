          },
          "conditions": [
            {
              "id": "is-verification",
              "leftValue": "={{ $json.query?.['hub.challenge'] }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "wa-is-verification",
      "name": "¿Verificación de Meta?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.query['hub.challenge'] }}",
        "options": {}
      },
      "id": "wa-respond-challenge",
      "name": "Devolver hub.challenge",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [460, 180]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "EVENT_RECEIVED",
        "options": {}
      },
      "id": "wa-respond-200",
      "name": "Acusar recibo (200)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [460, 420]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "has-message",
              "leftValue": "={{ $json.body?.entry?.[0]?.changes?.[0]?.value?.messages?.[0]?.id }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "wa-is-message",
      "name": "¿Es un mensaje entrante?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [680, 420]
    },
    {
      "parameters": {
        "jsCode": "// Aplana el payload de Meta a los tres campos que espera la app.\n// Los eventos de estado (sent/delivered/read) ya se filtraron antes.\nconst body = $('Webhook WhatsApp').first().json.body;\nconst value = body.entry[0].changes[0].value;\nconst msg = value.messages[0];\n\n// El agente solo entiende texto. Se rescatan además las respuestas a botones\n// y listas, que llegan en otra forma pero siguen siendo texto del usuario.\nlet text = '';\nif (msg.type === 'text') text = msg.text.body;\nelse if (msg.type === 'button') text = msg.button?.text ?? '';\nelse if (msg.type === 'interactive') {\n  text = msg.interactive?.button_reply?.title ?? msg.interactive?.list_reply?.title ?? '';\n}\n// Audio, imagen, ubicación o sticker: se manda vacío a propósito y la app\n// responde pidiendo texto, en vez de quedarse callada.\n\nreturn [{\n  json: {\n    from: msg.from,\n    text,\n    messageId: msg.id,\n    phoneNumberId: value.metadata.phone_number_id,\n  },\n}];"
      },
      "id": "wa-extract",
      "name": "Extraer mensaje",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 340]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://TU-DOMINIO/api/integrations/whatsapp",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ from: $json.from, text: $json.text, messageId: $json.messageId }) }}",
        "options": { "timeout": 90000 }
      },
      "id": "wa-agent",
      "name": "Agente Geniorama",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 340],
      "credentials": {
        "httpHeaderAuth": { "id": "REEMPLAZAR", "name": "Geniorama Tickets — Bearer" }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $('Extraer mensaje').item.json.phoneNumberId }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', recipient_type: 'individual', to: $('Extraer mensaje').item.json.from, type: 'text', text: { preview_url: false, body: $json.reply } }) }}",
        "options": {}
      },
      "id": "wa-send",
      "name": "Enviar respuesta a WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 340],
      "credentials": {
        "httpHeaderAuth": { "id": "REEMPLAZAR", "name": "Meta WhatsApp Cloud API — Bearer" }
      }
    }
  ],
