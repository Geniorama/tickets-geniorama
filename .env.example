# ZeptoMail
ZEPTOMAIL_TOKEN=""
ZEPTOMAIL_FROM=""

# Base de datos — AWS RDS PostgreSQL (us-east-1)
# Nota: no incluir sslmode en la URL — SSL se configura en src/lib/prisma.ts
# Formato: postgresql://user:password@host:5432/dbname
DATABASE_URL=""

# NextAuth v5
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Cloudflare R2
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET=""

# URL pública del bucket R2 (opcional pero recomendado).
# Si no se define, se usarán presigned URLs con 7 días de validez.
# Opciones:
#   - Subdominio r2.dev:    https://pub-xxxxxxxx.r2.dev
#   - Custom domain (R2):   https://media.tudominio.com
CLOUDFLARE_R2_PUBLIC_URL=""

# Integración de hosting (POST /api/integrations/hosting-provisioned)
# Token que el sistema de pedidos manda como `Authorization: Bearer <token>`.
INTEGRATION_HOSTING_TOKEN=""

# Integración de briefs (n8n → POST /api/integrations/brief)
# Token que n8n manda como `Authorization: Bearer <token>`.
# Si no está definido, el endpoint responde 401 a todo.
INTEGRATION_BRIEF_TOKEN=""

# IA — proveedores (el usuario elige Gemini u OpenAI por petición)
# Google Gemini (requerido para las funciones de IA con Gemini)
GOOGLE_AI_API_KEY=""
# OpenAI (opcional; requerido solo si se usa OpenAI como alternativa)
OPENAI_API_KEY=""
# Modelo de OpenAI a usar (opcional; por defecto: gpt-4o-mini)
OPENAI_MODEL="gpt-4o-mini"

# Hooks y API pública (v1.66.0): no necesitan variables de entorno.
# Los hooks generan su propio secreto de firma al crearse y las llaves de la API
# se administran desde /admin/integraciones. `AUTH_URL` sí importa: es la base de
# las URLs que viajan en los payloads de los hooks.

# ─── Notificaciones push ─────────────────────────────────────────────────────
# Sin estas claves la app funciona igual: el interruptor del perfil avisa de que
# falta configurarlo y no se intenta enviar nada.
# Se generan una sola vez con:  npx web-push generate-vapid-keys
# En producción van en el .env.local DEL SERVIDOR, que el despliegue no pisa.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A quién reclamar si un envío se porta mal. Lo exigen los servicios de push.
VAPID_SUBJECT=mailto:soporte@geniorama.co
